[node name="StatSep" type="HSeparator" parent="CreatorPanel/CreatorRow/RightMargin/PresetEditColumn"]
layout_mode = 2

[node name="StatRows" type="VBoxContainer" parent="CreatorPanel/CreatorRow/RightMargin/PresetEditColumn"]
unique_name_in_owner = true
layout_mode = 2

[node name="SummaryLabel" type="Label" parent="CreatorPanel/CreatorRow/RightMargin/PresetEditColumn"]
unique_name_in_owner = true
layout_mode = 2
text = ""
autowrap_mode = 3
