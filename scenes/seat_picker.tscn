render_target_update_mode = 4

[node name="PreviewWorld" type="Node3D" parent="SeatPanel/SeatMargin/SeatColumn/PreviewContainer/PreviewViewport"]

[node name="PreviewEnvironment" type="WorldEnvironment" parent="SeatPanel/SeatMargin/SeatColumn/PreviewContainer/PreviewViewport/PreviewWorld"]
