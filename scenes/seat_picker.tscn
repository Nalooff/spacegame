[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/ui/seat_picker.gd" id="1_s"]
[ext_resource type="Script" path="res://scripts/ship/hull_renderer.gd" id="2_hull"]
[ext_resource type="Shader" path="res://shaders/hull.gdshader" id="3_sh"]

[sub_resource type="ProceduralSkyMaterial" id="Sky_preview"]

[sub_resource type="Sky" id="Sky2_preview"]
