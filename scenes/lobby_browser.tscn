[connection signal="pressed" from="BrowserMargin/BrowserColumns/BrowseColumn/BrowseButtonsRow/BackButton" to="." method="_on_back_pressed"]
[connection signal="item_selected" from="BrowserMargin/BrowserColumns/BrowseColumn/LobbyTree" to="." method="_on_lobby_selected"]
