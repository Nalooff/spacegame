layout_mode = 2
text = "Pilot"
size_flags_horizontal = 3

[node name="HostSeparator" type="HSeparator" parent="BrowserMargin/BrowserColumns/HostColumn"]
layout_mode = 2

[node name="HostHeading" type="Label" parent="BrowserMargin/BrowserColumns/HostColumn"]
layout_mode = 2
text = "HOST A LOBBY"
theme_override_font_sizes/font_size = 20
modulate = Color(0.62, 0.8, 1, 1)

[node name="LobbyNameLabel" type="Label" parent="BrowserMargin/BrowserColumns/HostColumn"]
layout_mode = 2
text = "Lobby name"

[node name="LobbyNameEdit" type="LineEdit" parent="BrowserMargin/BrowserColumns/HostColumn"]
unique_name_in_owner = true
layout_mode = 2
text = ""
size_flags_horizontal = 3
placeholder_text = "My lobby"

[node name="VisibilityPicker" type="OptionButton" parent="BrowserMargin/BrowserColumns/HostColumn"]
unique_name_in_owner = true
layout_mode = 2
item_count = 2
selected = 0
popup/item_0/text = "Public (anyone can join)"
popup/item_0/id = 0
popup/item_1/text = "Private (password)"
popup/item_1/id = 1

[node name="PasswordRow" type="HBoxContainer" parent="BrowserMargin/BrowserColumns/HostColumn"]
unique_name_in_owner = true
layout_mode = 2
visible = false

[node name="PasswordLabel" type="Label" parent="BrowserMargin/BrowserColumns/HostColumn/PasswordRow"]
layout_mode = 2
text = "Password"

[node name="PasswordEdit" type="LineEdit" parent="BrowserMargin/BrowserColumns/HostColumn/PasswordRow"]
unique_name_in_owner = true
layout_mode = 2
text = ""
size_flags_horizontal = 3
secret = true
placeholder_text = "Password"

[node name="CreateLobbyButton" type="Button" parent="BrowserMargin/BrowserColumns/HostColumn"]
layout_mode = 2
text = "Create lobby"
custom_minimum_size = Vector2(0, 48)

[node name="HostStatusLabel" type="Label" parent="BrowserMargin/BrowserColumns/HostColumn"]
unique_name_in_owner = true
layout_mode = 2
text = ""
