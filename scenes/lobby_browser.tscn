[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/lobby_browser.gd" id="1_s"]

[node name="LobbyBrowser" type="Control"]
script = ExtResource("1_s")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="BackgroundColor" type="ColorRect" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.03, 0.04, 0.07, 1)

[node name="BrowserMargin" type="MarginContainer" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 30

[node name="BrowserColumns" type="HBoxContainer" parent="BrowserMargin"]
layout_mode = 2
theme_override_constants/separation = 30

[node name="HostColumn" type="VBoxContainer" parent="BrowserMargin/BrowserColumns"]
layout_mode = 2
theme_override_constants/separation = 8
custom_minimum_size = Vector2(380, 0)

[node name="PlayTitleLabel" type="Label" parent="BrowserMargin/BrowserColumns/HostColumn"]
layout_mode = 2
text = "PLAY"
theme_override_font_sizes/font_size = 28

[node name="PilotNameRow" type="HBoxContainer" parent="BrowserMargin/BrowserColumns/HostColumn"]
layout_mode = 2

[node name="PilotNameLabel" type="Label" parent="BrowserMargin/BrowserColumns/HostColumn/PilotNameRow"]
layout_mode = 2
text = "Pilot name"

[node name="PilotNameEdit" type="LineEdit" parent="BrowserMargin/BrowserColumns/HostColumn/PilotNameRow"]
