[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/tactical_map.gd" id="1_s"]

[node name="TacticalMap" type="Control"]
script = ExtResource("1_s")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="MapBackdrop" type="ColorRect" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.015, 0.03, 0.97)
mouse_filter = 0

[node name="MapPanel" type="PanelContainer" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 40.0
offset_top = 40.0
offset_right = -40.0
offset_bottom = -40.0

[node name="MapRow" type="HBoxContainer" parent="MapPanel"]
layout_mode = 2

[node name="MapCanvas" type="Control" parent="MapPanel/MapRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
clip_contents = true
focus_mode = 2

[node name="OrdersMargin" type="MarginContainer" parent="MapPanel/MapRow"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_right = 8

[node name="OrdersColumn" type="VBoxContainer" parent="MapPanel/MapRow/OrdersMargin"]
layout_mode = 2
custom_minimum_size = Vector2(300, 0)

[node name="OrdersTitleLabel" type="Label" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
layout_mode = 2
text = "ORDERS"

[node name="GoToButton" type="Button" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
unique_name_in_owner = true
layout_mode = 2
text = "GO TO  (stop there)"
toggle_mode = true
button_pressed = true

[node name="DriveButton" type="Button" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
unique_name_in_owner = true
layout_mode = 2
text = "DRIVE  (never stops)"
toggle_mode = true

[node name="ThrustRow" type="HBoxContainer" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
layout_mode = 2

[node name="ThrustLabel" type="Label" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn/ThrustRow"]
layout_mode = 2
text = "Thrust"

[node name="ThrustSlider" type="HSlider" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn/ThrustRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 100.0
step = 1.0
value = 100.0

[node name="ThrustValueLabel" type="Label" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn/ThrustRow"]
unique_name_in_owner = true
layout_mode = 2
text = "100%"
custom_minimum_size = Vector2(48, 0)

[node name="AltitudeRow" type="HBoxContainer" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
layout_mode = 2

[node name="AltitudeLabel" type="Label" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn/AltitudeRow"]
layout_mode = 2
text = "Height"

[node name="AltitudeSpin" type="SpinBox" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn/AltitudeRow"]
unique_name_in_owner = true
layout_mode = 2
min_value = -100000
max_value = 100000
step = 1
value = 0
size_flags_horizontal = 3
allow_greater = true
allow_lesser = true
suffix = " m"

[node name="FaceTurretsCheck" type="CheckBox" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
unique_name_in_owner = true
layout_mode = 2
text = "Keep turrets facing the enemy"
tooltip_text = "The ship turns so the most turrets can bear on the locked enemy (or the destination) while it moves."

[node name="WeaponsFreeCheck" type="CheckBox" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
unique_name_in_owner = true
layout_mode = 2
text = "Weapons free  (H)"
tooltip_text = "Off: radar locks and aims, the guns wait for you to hold the left mouse button."

[node name="ChaseButton" type="Button" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
unique_name_in_owner = true
layout_mode = 2
text = "Drive at locked target"

[node name="StopRow" type="HBoxContainer" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
layout_mode = 2

[node name="MapBrakeButton" type="Button" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn/StopRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Brake  (X)"

[node name="MapCancelButton" type="Button" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn/StopRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Cancel order"

[node name="OrderInfoLabel" type="Label" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
unique_name_in_owner = true
layout_mode = 2
text = ""
autowrap_mode = 3

[node name="MapHelpLabel" type="Label" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
layout_mode = 2
text = "Click: set a waypoint (and go).  Click an enemy: lock it, and in DRIVE mode ram it.\nRight-drag: pan.  Wheel: zoom.  Right ruler: click to set the height."
autowrap_mode = 3
modulate = Color(1, 1, 1, 0.6)

[node name="CloseMapButton" type="Button" parent="MapPanel/MapRow/OrdersMargin/OrdersColumn"]
unique_name_in_owner = true
layout_mode = 2
text = "Close  (M)"

