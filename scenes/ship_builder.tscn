[sub_resource type="ButtonGroup" id="ButtonGroup_modes"]

[sub_resource type="Theme" id="Theme_builder"]
default_font_size = 15

[sub_resource type="Environment" id="Env_builder"]
background_mode = 1
background_color = Color(0.04, 0.05, 0.08, 1)
ambient_light_source = 2
ambient_light_color = Color(0.75, 0.8, 0.95, 1)
ambient_light_energy = 0.7

[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;\nrender_mode unshaded, blend_mix, depth_draw_never, cull_disabled;\nvarying vec3 wp;\nvoid vertex() { wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }\nvoid fragment() {\n	vec2 g = abs(fract(wp.xz - 0.5) - 0.5) / fwidth(wp.xz);\n	float l = 1.0 - min(min(g.x, g.y), 1.0);\n	ALBEDO = vec3(0.4, 0.6, 0.9);\n	ALPHA = l * 0.28;\n}\n"

[sub_resource type="ShaderMaterial" id="Mat_grid"]
shader = SubResource("Shader_grid")

[sub_resource type="PlaneMesh" id="Plane_grid"]
size = Vector2(60, 60)

[sub_resource type="StandardMaterial3D" id="Mat_ship"]
vertex_color_use_as_albedo = true
metallic = 0.2
roughness = 0.6
cull_mode = 2

[sub_resource type="StandardMaterial3D" id="Mat_dots"]
shading_mode = 0
vertex_color_use_as_albedo = true
no_depth_test = true
render_priority = 5

[sub_resource type="SphereMesh" id="Mesh_dot"]
material = SubResource("Mat_dots")
radius = 0.5
height = 1.0
radial_segments = 10
rings = 5

[sub_resource type="MultiMesh" id="MM_dots"]
transform_format = 1
use_colors = true
mesh = SubResource("Mesh_dot")

[sub_resource type="StandardMaterial3D" id="Mat_overlay"]
shading_mode = 0
vertex_color_use_as_albedo = true
no_depth_test = true
transparency = 1
cull_mode = 2
render_priority = 4

[sub_resource type="ImmediateMesh" id="IM_overlay"]

